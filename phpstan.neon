includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - src
        - config

    # No baseline. A baseline is standing permission to be wrong, and this is a
    # greenfield package; if analysis fails, the code is what should change.

    excludePaths:
        # Conditionally defined: the class only exists when Filament is
        # installed, and the file-level guard before the declaration is
        # precisely the thing PHPStan cannot model.
        - src/Integrations/Filament/ConfettiPlugin.php

    ignoreErrors:
        # Public extension points. PHPStan only scans src/, so a trait meant for
        # consuming applications looks unused from in here.
        -
            message: '#Trait Simtabi\\Laranail\\Confetti\\(Integrations\\Livewire\\InteractsWithConfetti|Testing\\InteractsWithConfetti) is used zero times#'

        # The builder composes its API from concerns that read state declared on
        # the builder itself, which is the shape the fluent interface requires.
        -
            identifier: missingType.iterableValue

        # env() is exactly what belongs in a config file. The rule targets
        # application code, where a cached config would make the call return
        # null. Scoped to this one file so it still applies everywhere else.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/confetti.php

        # Larastan resolves view-string by looking in the application's view
        # paths, and `confetti::` is a namespace this package registers at boot
        # so there is no directory for it to find. The view is covered by the
        # Blade component, middleware and Filament tests instead.
        -
            identifier: argument.type
            message: '#\$view of function view expects view-string\|null, string given#'
            paths:
                - src/View/ConfettiTags.php
                - src/View/Components/Scripts.php

    treatPhpDocTypesAsCertain: false
